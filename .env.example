# Copy this file to `.env` (same folder as manage.py) and fill in real values.
# `.env` is gitignored — never commit real credentials.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.gmail.address@gmail.com
# 16-character Google App Password (NOT your normal Gmail password).
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=your.gmail.address@gmail.com
CONTACT_RECIPIENT_EMAIL=jeylofton@gmail.com

# Optional: during local development you can use the console backend to print
# emails to the terminal instead of actually sending them.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
